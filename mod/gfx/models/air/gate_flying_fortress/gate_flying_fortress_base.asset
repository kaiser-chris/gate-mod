pdxmesh = {
	name = "gate_flying_fortress_base_mesh"
	file = "gate_flying_fortress_base.mesh"

	lod_percentages = {
		lod = { index = 1 percent = 8.0 }
		lod = { index = 2 percent = 4.0 }
	}

	scale = 3.0

	animation = { id = "moving_animation" type = "gate_flying_fortress_base_moving.anim" }

	meshsettings = {
		name = "LOD_0|mesh|meshShape"
		index = 0
		texture_diffuse = "gate_flying_fortress_base_diffuse.dds"
		texture_normal = "gate_flying_fortress_base_normal.dds"
		texture_specular = "gate_flying_fortress_base_properties.dds"
		shader = "standard"
		additional_shader_defines = { "EMISSIVE_NIGHT" }
		shader_file = "gfx/FX/pdxmesh.shader"
	}
	meshsettings = {
		name = "LOD_1|mesh|meshShape"
		index = 0
		texture_diffuse = "gate_flying_fortress_base_diffuse.dds"
		texture_normal = "gate_flying_fortress_base_normal.dds"
		texture_specular = "gate_flying_fortress_base_properties.dds"
		shader = "standard"
		additional_shader_defines = { "EMISSIVE_NIGHT" }
		shader_file = "gfx/FX/pdxmesh.shader"
	}
	meshsettings = {
		name = "LOD_2|mesh|meshShape"
		index = 0
		texture_diffuse = "gate_flying_fortress_base_diffuse.dds"
		texture_normal = "gate_flying_fortress_base_normal.dds"
		texture_specular = "gate_flying_fortress_base_properties.dds"
		shader = "standard"
		additional_shader_defines = { "EMISSIVE_NIGHT" }
		shader_file = "gfx/FX/pdxmesh.shader"
	}
	meshsettings = {
		name = "LOD_0|glow|glowShape"
		index = 0
		texture_diffuse = "gate_flying_fortress_base_glow_diffuse.dds"
		texture_normal = "gate_flying_fortress_base_glow_diffuse.dds"
		texture_specular = "gate_flying_fortress_base_glow_diffuse.dds"
		shader = "gate_glow"
		shader_file = "gfx/FX/gate_glow.shader"
	}
	meshsettings = {
		name = "LOD_1|glow|glowShape"
		index = 0
		texture_diffuse = "gate_flying_fortress_base_glow_diffuse.dds"
		texture_normal = "gate_flying_fortress_base_glow_diffuse.dds"
		texture_specular = "gate_flying_fortress_base_glow_diffuse.dds"
		shader = "gate_glow"
		shader_file = "gfx/FX/gate_glow.shader"
	}
	meshsettings = {
		name = "LOD_2|glow|glowShape"
		index = 0
		texture_diffuse = "gate_flying_fortress_base_glow_diffuse.dds"
		texture_normal = "gate_flying_fortress_base_glow_diffuse.dds"
		texture_specular = "gate_flying_fortress_base_glow_diffuse.dds"
		shader = "gate_glow"
		shader_file = "gfx/FX/gate_glow.shader"
	}
}

entity = {
	name = "gate_flying_fortress_base_entity"
	pdxmesh = "gate_flying_fortress_base_mesh"
	default_state = "moving"
	state = {
		name = "moving"
		animation = "moving_animation"
		looping = yes
		next_state = "moving"
	}
}

entity = {
	clone = "gate_flying_fortress_base_entity"
	name = "gate_flying_fortress_cannons_entity"
	attach = { name = "weapons" root = "gate_flying_fortress_weapons_entity" }
}

entity = {
	clone = "gate_flying_fortress_base_entity"
	name = "gate_flying_fortress_armored_entity"
	attach = { name = "armor" root = "gate_flying_fortress_armor_entity" }
}

entity = {
	clone = "gate_flying_fortress_base_entity"
	name = "gate_flying_fortress_cannons_armored_entity"
	attach = { name = "weapons" root = "gate_flying_fortress_weapons_entity" }
	attach = { name = "armor" root = "gate_flying_fortress_armor_entity" }
}
