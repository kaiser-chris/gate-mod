entity = {
	name = "gate_elven_city_centerpiece_entity"
	pdxmesh = "gate_elven_city_centerpiece_mesh"

	default_state = "idle"
	locator = { name = "birds" position = { 0 1.6 0 } }
	state = {
		name = "idle"
		state_time = 5
		looping = yes
		start_event = { time = 0 node = "birds" entity = "seagull_port_entity" trigger_once = yes }
	}
}
