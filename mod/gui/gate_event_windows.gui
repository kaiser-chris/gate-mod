    type gate_scale_button = button {
        minimumsize = { 30 -1 }
        layoutpolicy_vertical = expanding
        using = default_button_animation
        using = confirm_button_sound

        icon = {
            parentanchor = center
            size = { 30 5 }
            texture = gfx/interface/backgrounds/divider_gold.dds
        }
    }

}