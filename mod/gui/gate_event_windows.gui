
types gate_event_window_types {

    type event_window_gate_dungeon = default_popup_two_lines {
        name = event_window_gate_dungeon
        datacontext = "[EventWindow.GetEvent]"
        datacontext = "[EventWindow.GetEvent.GetTopScope.GetLocalVariable('expedition').GetScriptContainer]"

        alpha = 0

        blockoverride "minimize" {
            minimize_button_large = {
                onclick = "[PopupManager.HideOpenEvent(Event.Self)]"
                parentanchor = center
                shortcut = "close_window"
            }
        }

        blockoverride "header_close_button_visibility" {
            visible = yes
        }

        blockoverride "window_header_name" {
            raw_text = "#BOLD [EventWindow.GetTitle]#!"
        }

        blockoverride "content" {}

        blockoverride "second_text" {
            datacontext = "[ScriptContainer.MakeScope.Var('dungeon')]"
            text = event_gate_dungeon
            tooltipwidget = {
                gate_dungeon_tooltip = {}
            }
        }

        blockoverride "goto_visibility" {
            visible = yes
        }

        blockoverride "goto_properties" {
            onclick = "[EventWindow.AccessEvent.AccessState.ZoomToCapital]"
            tooltip = "ZOOM_TO_EVENT_WINDOW_STATE"
            enabled = "[Not( EventWindow.AccessEvent.AccessState.IsZoomingToCapital )]"
        }

        state = {
            trigger_on_create = yes
            name = 1
            duration = 0.3
            using = Animation_Curve_EaseOut
            alpha = 1
            using = Snapshot_Mute_World_100
            using = Snapshot_Mute_Vfx_War_100
            start_sound = {
                soundeffect = "[Event.GetOnOpenedSoundEvent]"
            }
        }


        ### SETTING SIZE OF WINDOW
        flowcontainer = {
            resizeparent = yes
            margin = { 30 0 }
            margin_bottom = 35

            container = {
                ### HEADER FLAGS / PORTRAITS / ICONS
                event_icon = {
                    position = { 20 0 }
                    datacontext = "[Event.GetIcon('minor_left_icon')]"
                }

                event_icon = {
                    parentanchor = right
                    position = { -25 0 }
                    datacontext = "[Event.GetIcon('minor_right_icon')]"
                }

                container = {
                    position = { 0 90 }

                    ### INNER FRAME + FADE OVER THE IMAGE
                    icon = {
                        texture = "gfx/interface/event_window/event_inner_frame.dds"
                        size = { 100% 100% }
                        spriteType = Corneredtiled
                        spriteborder = { 25 25 }
                        spriteborder_right = 610
                        spriteborder_top = 600
                        texture_density = 2

                        modify_texture = {
                            texture = "gfx/interface/backgrounds/default_bg_shading.dds"
                            spriteType = Corneredstretched
                            spriteborder = { 0 0 }
                            blend_mode = overlay
                        }

                        modify_texture = {
                            using = texture_velvet
                        }
                    }

                    ### EVENT IMAGE
                    widget = {
                        position = { 3 3 }
                        size = { 100% 100% }
                        block "event_content" {

                            # image in case we have no video?
                            icon = {
                                visible = "[Event.HasTexture]"
                                texture = "[Event.GetTexture]"
                                alwaystransparent = yes
                                size = { 100% 100% }

                                modify_texture = {
                                    texture = "gfx/interface/masks/fade_horizontal_right.dds"
                                    spriteType = Corneredstretched
                                    spriteborder = { 45 45 }
                                    spriteborder_bottom = 0
                                    blend_mode = alphamultiply
                                    texture_density = 2
                                }

                                modify_texture = {
                                    using = texture_velvet
                                }
                            }

                            # animated video ( most images should have this )
                            video_icon = {
                                visible = "[Event.HasVideo]"
                                video = "[Event.GetVideo]"
                                size = { 100% 100% }
                                alwaystransparent = yes
                                loop = no

                                modify_texture = {
                                    texture = "gfx/interface/masks/fade_horizontal_right.dds"
                                    spriteType = Corneredstretched
                                    spriteborder = { 45 45 }
                                    spriteborder_bottom = 0
                                    blend_mode = alphamultiply
                                    texture_density = 2
                                }

                                modify_texture = {
                                    using = texture_velvet
                                }
                            }
                        }
                    }

                    ### CONTENT
                    flowcontainer = {
                        spacing = 30
                        margin = { 20 20 }

                        widget = {
                            size = { 600 10 }
                        }

                        ### DUNGEON LAYERS
                        # flowcontainer = {
                        #     direction = vertical
                        #     margin = { 25 0 }
                        #     margin_bottom = 45
                        #     margin_top = 16
                        #     spacing = 20
                        #
                        #     background = {
                        #         using = entry_bg_simple_solid
                        #     }
                        #
                        #     ### DUNGEON INFORMATION
                        #     flowcontainer = {
                        #         direction = vertical
                        #         spacing = 10
                        #
                        #         default_header_clean_faded = {
                        #             parentanchor = hcenter
                        #             blockoverride "text" {
                        #                 text = "[concept_gate_dungeon]"
                        #             }
                        #             blockoverride "size" {
                        #                 size = { 500 45 }
                        #             }
                        #         }
                        #         widget = {
                        #             parentanchor = hcenter
                        #             size = { 450 23 }
                        #
                        #             textbox = {
                        #                 autoresize = yes
                        #                 parentanchor = left
                        #                 text = je_gate_expedition_dungeon_name
                        #             }
                        #
                        #             textbox = {
                        #                 autoresize = yes
                        #                 parentanchor = right
                        #                 text = "#yellow [ScriptContainer.MakeScope.Var('dungeon').Var('name').GetFlagName]#!"
                        #                 tooltipwidget = {
                        #                     gate_dungeon_tooltip = {
                        #                         datacontext = "[ScriptContainer.MakeScope.Var('dungeon')]"
                        #                     }
                        #                 }
                        #             }
                        #         }
                        #         widget = {
                        #             parentanchor = hcenter
                        #             size = { 450 23 }
                        #
                        #             textbox = {
                        #                 autoresize = yes
                        #                 parentanchor = left
                        #                 text = je_gate_expedition_dungeon_location
                        #             }
                        #             textbox = {
                        #                 autoresize = yes
                        #                 parentanchor = right
                        #                 text = "[ScriptContainer.MakeScope.Var('dungeon').Var('location').GetStateRegion.GetName]"
                        #             }
                        #         }
                        #         widget = {
                        #             parentanchor = hcenter
                        #             size = { 450 23 }
                        #
                        #             textbox = {
                        #                 autoresize = yes
                        #                 parentanchor = left
                        #                 text = je_gate_expedition_dungeon_layer_active
                        #             }
                        #             textbox = {
                        #                 autoresize = yes
                        #                 parentanchor = right
                        #                 text = "#yellow [ScriptContainer.MakeScope.Var('current_layer').Var('name').GetFlagName]#!"
                        #                 tooltipwidget = {
                        #                     gate_dungeon_tooltip = {
                        #                         datacontext = "[ScriptContainer.MakeScope.Var('current_layer')]"
                        #                     }
                        #                 }
                        #             }
                        #         }
                        #         textbox = {
                        #             parentanchor = hcenter
                        #             minimumsize = { 450 -1 }
                        #             maximumsize = { 450 -1 }
                        #             autoresize = yes
                        #             multiline = yes
                        #             raw_text = "[ScriptContainer.MakeScope.Var('dungeon').Var('desc').GetFlagName]"
                        #         }
                        #     }
                        #
                        #     ### DUNGEON LAYERS
                        #     flowcontainer = {
                        #         direction = vertical
                        #         default_header_clean_faded = {
                        #             parentanchor = hcenter
                        #             blockoverride "text" {
                        #                 text = "[Concept('concept_gate_dungeon_layer', Localize('concept_gate_dungeon_layers'))]"
                        #             }
                        #             blockoverride "size" {
                        #                 size = { 500 45 }
                        #             }
                        #         }
                        #
                        #         gate_dungeon_layers = {
                        #             blockoverride "datamodel" {
                        #                 datamodel = "[DataModelFirst(ScriptContainer.MakeScope.Var('dungeon').GetList('layers'), '(int32)1')]"
                        #             }
                        #             blockoverride "top_line" {
                        #                 visible = no
                        #             }
                        #         }
                        #         gate_dungeon_layers = {
                        #             blockoverride "datamodel" {
                        #                 datamodel = "[DataModelSubSpan(
                        #                 ScriptContainer.MakeScope.Var('dungeon').GetList('layers'),
                        #                 '(int32)1',
                        #                 GetDataModelSize(ScriptContainer.MakeScope.Var('dungeon').GetList('layers'))
                        #             )]"
                        #             }
                        #         }
                        #     }
                        # }

                        ### TITLE / TEXT / OPTIONS
                        flowcontainer = {
                            minimumsize = { 550 606 }
                            maximumsize = { 550 -1 }
                            direction = vertical
                            spacing = 20
                            parentanchor = right|vcenter
                            margin = { 25 40 }

                            background = {
                                using = entry_bg_simple_solid
                            }

                            background = {
                                using = fade_center_colored_black
                            }

                            textbox = {
                                name = "description"
                                multiline = yes
                                autoresize = yes
                                minimumsize = { 500 -1 }
                                maximumsize = { 500 -1 }
                                parentanchor = top|hcenter
                                align = nobaseline
                                margin = { 10 0 }
                                using = fontsize_large
                                raw_text = "#bold [EventWindow.GetDescription]#!"
                            }

                            divider_decorative = { }

                            textbox = {
                                name = "flavortext"
                                multiline = yes
                                autoresize = yes
                                minimumsize = { 500 -1 }
                                maximumsize = { 500 -1 }
                                parentanchor = top|hcenter
                                align = top|left
                                margin = { 10 10 }
                                raw_text = "[EventWindow.GetFlavor]"
                            }

                            gate_dungeon_layer_progress_line = {}

                            flowcontainer = {
                                direction = vertical
                                using = default_list_position
                                datamodel = "[EventWindow.GetOptions]"
                                spacing = 5

                                item = {
                                    container = {

                                        widget = {
                                            visible = "[EventOption.IsHighlightedOption]"

                                            button = {
                                                size = { 96% 100% }
                                                parentanchor = hcenter
                                                using = default_button_primary_action
                                                tooltip = "[EventOption.GetDesc]"
                                                using = tooltip_ws
                                                using = confirm_button_sound
                                                onclick = "[EventOption.Select]"
                                                enabled = "[EventOption.IsEnabled]"
                                            }

                                            textbox = {
                                                resizeparent = yes
                                                minimumsize = { 500 42 }
                                                maximumsize = { 500 -1 }
                                                multiline = yes
                                                align = "[GetEventOptionTextAlignment]"
                                                autoresize = yes
                                                margin = { 30 10 }
                                                text = "[EventOption.GetText]"
                                            }
                                        }

                                        widget = {
                                            visible = "[Not(EventOption.IsHighlightedOption)]"

                                            button = {
                                                size = { 96% 100% }
                                                parentanchor = hcenter
                                                using = default_button_action
                                                tooltip = "EVENT_OPTION_TOOLTIP"
                                                using = tooltip_ws
                                                using = confirm_button_sound
                                                onclick = "[EventOption.Select]"
                                                enabled = "[EventOption.IsEnabled]"
                                            }

                                            textbox = {
                                                resizeparent = yes
                                                minimumsize = { 500 42 }
                                                maximumsize = { 500 -1 }
                                                text = "[EventOption.GetText]"
                                                multiline = yes
                                                align = "[GetEventOptionTextAlignment]"
                                                autoresize = yes
                                                margin = { 25 10 }
                                                margin_right = 50
                                            }

                                            ### Time until the default option will be picked
                                            round_progress_default = {
                                                visible = "[EventOption.IsDefaultOption]"
                                                parentanchor = right|vcenter
                                                position = { -20 0.5 }
                                                size = { 27 27 }
                                                tooltip = "DEFAULT_EVENT_OPTION"
                                                value = "[Event.GetPercentageRemainingDays]"

                                                icon = {
                                                    size = { 26 26 }
                                                    position = { -0.2 -0.2 }
                                                    parentanchor = center
                                                    texture = "gfx/interface/icons/generic_icons/event_default_option.dds"
                                                }
                                            }
                                        }
                                    }
                                }
                            }

                            button = {
                                visible = "[InDebugMode]"
                                parentanchor = hcenter
                                size = { 480 62 }
                                using = default_button
                                raw_text = "DEBUG: Open Event in text editor"
                                onclick = "[EventWindow.AccessEvent.OpenInEditor]"
                            }

                            textbox = {
                                visible = "[InDebugMode]"
                                parentanchor = hcenter
                                size = { 480 62 }
                                raw_text = "DEBUG: Trigger description"
                                tooltip = "[Event.GetTriggerDesc]"
                                align = hcenter|nobaseline

                                background = {
                                    using = default_background
                                }
                            }

                            textbox = {
                                visible = "[InDebugMode]"
                                parentanchor = hcenter
                                align = hcenter
                                raw_text = "Event ID: [Event.GetKey|v]"
                            }
                        }
                    }

                    ### DLC ICON
                    flowcontainer = {
                        visible = "[Event.IsDLCContent]"
                        spacing = 5
                        parentanchor = bottom
                        righttoleft = yes
                        position = { 10 10 }
                        tooltip = "EVENT_DLC_TOOLTIP"

                        textbox = {
                            autoresize = yes
                            align = vcenter
                            parentanchor = vcenter
                            using = fontsize_large
                            using = elide_fontsize_min
                            alpha = 0.7
                            text = "[Event.GetDLCName]"

                            background = {
                                using = dark_area
                                margin = { 10 5 }
                                margin_left = 20
                                alpha = 1
                            }
                        }

                        icon = {
                            parentanchor = vcenter
                            size = { 50 50 }
                            texture = "[Event.GetDLCIcon]"
                        }
                    }
                }
            }
        }
    }

}