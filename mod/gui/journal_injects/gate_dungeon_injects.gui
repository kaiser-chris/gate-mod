@layer_width = 500
@layer_height = 52

flowcontainer = {
	name = "gate_inject_dungeon"
	parentanchor = hcenter
	direction = vertical
	spacing = 12
	visible = "[JournalEntry.MakeScope.Var('expedition').IsSet]"
	datacontext = "[JournalEntry.MakeScope.Var('expedition').GetScriptContainer]"

	gate_journal_dungeon_expedition = {
		parentanchor = hcenter
	}

	gate_dungeon_layer_progress_line = {}

	gate_journal_dungeon_layers = {}
}

types gate_inject_dungeon_types {

	type gate_journal_dungeon_expedition = widget {
		block "dungeon_expedition_widget_size" {
			size = { 500 300 }
		}

		background = {
			visible = "[GetIdeology(ScriptContainer.MakeScope.Var('dungeon').Var('type').GetFlagName).GetTexture]"
			texture = gfx/map/gate/dungeon/types/cave_01.dds
			fittype = centercrop
			alpha = 0.5
		}

		flowcontainer = {
			parentanchor = right|vcenter
			direction = vertical
			spacing = 5

			com_journal_entry_frame_text = {
				visible = "[ScriptContainer.MakeScope.Var('current_layer').IsSet]"
				blockoverride "text_top" {
					text = je_gate_expedition_dungeon_layer_active
				}
				blockoverride "text" {
					raw_text = "#yellow [ScriptContainer.MakeScope.Var('current_layer').Var('name').GetFlagName]#!"
				}
				blockoverride "icon" {
					visible = no
				}
				tooltipwidget = {
					gate_dungeon_layer_tooltip = {
						datacontext = "[ScriptContainer.MakeScope.Var('current_layer')]"
					}
				}
			}

			com_journal_entry_frame_text = {
				blockoverride "text_top" {
					raw_text = "[Concept('concept_gate_dungeon_party_cohesion', Localize('concept_gate_dungeon_party_cohesion_medium'))]"
				}
				blockoverride "text" {
					raw_text = "[ScriptContainer.MakeScope.ScriptValue('gate_dungeon_party_cohesion_value')|0v] / [ScriptContainer.MakeScope.ScriptValue('gate_dungeon_party_cohesion_max_value')|0]"
				}
				blockoverride "icon" {
					visible = no
				}
				tooltip = je_gate_expedition_dungeon_cohesion_tooltip
			}

			com_journal_entry_frame_text = {
				blockoverride "text_top" {
					raw_text = "[Concept('concept_gate_dungeon_party_condition', Localize('concept_gate_dungeon_party_condition_medium'))]"
				}
				blockoverride "text" {
					raw_text = "[ScriptContainer.MakeScope.ScriptValue('gate_dungeon_party_condition_value')|0v] / [ScriptContainer.MakeScope.ScriptValue('gate_dungeon_party_condition_max_value')|0]"
				}
				blockoverride "icon" {
					visible = no
				}
				tooltip = je_gate_expedition_dungeon_condition_tooltip
			}

			com_journal_entry_frame_text = {
				blockoverride "text_top" {
					raw_text = "[Concept('concept_gate_dungeon_party_renown', Localize('concept_gate_dungeon_party_renown_medium'))]"
				}
				blockoverride "text" {
					raw_text = "[ScriptContainer.MakeScope.ScriptValue('gate_dungeon_party_renown_value')|0v]"
				}
				blockoverride "icon" {
					visible = no
				}
				tooltip = je_gate_expedition_dungeon_renown_tooltip
			}
		}

		character_portrait_base_no_mask = {
			parentanchor = left|bottom
			ignore_in_debug_draw = yes
			size = { 300 300 }

			datacontext = "[ScriptContainer.MakeScope.Var('party').Var('party_leader').GetCharacter]"
			visible = "[ScriptContainer.MakeScope.Var('party').Var('party_leader').IsSet]"

			block "character_layout" {
				position = { -30 2 }
			}
			blockoverride "portrait_size" {
				block "character_portrait_size" {
					size = { 300 300 }
				}
			}
			blockoverride "portrait_texture" {
				portrait_texture = "[Character.GetAnimatedPortrait(
					'ruler_environment',
					'camera_body',
					'idle',
					GetPortraitRenderSize(PdxGuiWidget.Self))
				]"
			}
			blockoverride "portrait_icons" {}
			blockoverride "tooltip" {
				tooltipwidget = {
					FancyTooltip_Character = {}
				}
			}
		}

		icon = {
			position = { -30 2 }
			parentanchor = left|bottom
			size = { 300 300 }
			visible = "[Not(ScriptContainer.MakeScope.Var('party').Var('party_leader').IsSet)]"
			texture = gfx/portraits/example_portraits/unknown.dds
		}


		gate_titled_character = {
			parentanchor = left|bottom
			position = { 0 -20 }
			visible = "[Not(ScriptContainer.MakeScope.Var('party').Var('party_leader').IsSet)]"
			blockoverride "text_top" {
				text = je_gate_expedition_dungeon_party_leader
			}
			blockoverride "text" {
				raw_text = je_gate_expedition_dungeon_party_leader_empty
			}
			blockoverride "icon" {
				visible = no
			}
		}

		gate_titled_character = {
			parentanchor = left|bottom
			position = { 0 -20 }
			visible = "[ScriptContainer.MakeScope.Var('party').Var('party_leader').IsSet]"
			blockoverride "text_top" {
				text = je_gate_expedition_dungeon_party_leader
			}
			blockoverride "text" {
				raw_text = "[ScriptContainer.MakeScope.Var('party').Var('party_leader').GetCharacter.GetFullName]"
			}
			blockoverride "icon" {
				visible = no
			}
		}

		# FRAME
		widget = {
			size = { 100% 100% }
			background = {
				texture = "gfx/interface/character_panel/char_bg_frame.dds"
				margin_left = 18
				margin_right = 12
				margin_bottom = 10
				spriteType = Corneredtiled

				spriteborder_left = 200
				spriteborder_right = 60
				spriteborder_top = 170
				spriteborder_bottom = 180

				texture_density = 2
			}
		}
	}

	type gate_titled_character = widget {
		background = {
			using = dark_area
			alpha = 0.75

			modify_texture = {
				texture = "gfx/interface/masks/fade_horizontal_center.dds"
				blend_mode = alphamultiply
			}
		}

		size = { 250 53 }

		divider_clean = {
			parentanchor = top
		}
		divider_clean = {
			parentanchor = bottom
		}

		hbox = {
			margin_right = 13
			margin_left = 10
			layoutpolicy_horizontal = expanding
			layoutpolicy_vertical = expanding
			spacing = 7

			vbox = {
				layoutpolicy_horizontal = expanding
				layoutpolicy_vertical = expanding
				margin = { 0 7 }
				spacing = 3

				textbox = {
					layoutpolicy_horizontal = expanding
					size = { 0 16 }
					block "text_top" {
						raw_text = "#r frame_text text_top#!"
					}
					align = center
					elide = right
					fontsize_min = 12
				}

				textbox = {
					layoutpolicy_horizontal = expanding
					size = { 0 20 }
					block "text" {
						raw_text = "#r frame_text text#!"
					}
					align = center
					elide = right
					fontsize_min = 12
					using = fontsize_large
				}
			}

			icon = {
				size = { 35 35 }
				block "icon" {
					texture = gfx/interface/icons/alert_icons/placeholder.dds
				}
			}
		}
	}

	type gate_journal_dungeon_layers = flowcontainer {
		visible = "[DataModelHasItems(ScriptContainer.MakeScope.Var('dungeon').GetList('layers'))]"
		parentanchor = hcenter
		direction = vertical
		oncreate = "[BindFoldOutContext]"

		section_header_button = {
			parentanchor = hcenter
			onclick = "[PdxGuiFoldOut.Toggle]"

			blockoverride "layout" {
				size = { @layer_width 38 }
			}
			blockoverride "onclick_showmore" {
				visible = "[Not(PdxGuiFoldOut.IsUnfolded)]"
			}
			blockoverride "onclick_showless" {
				visible = "[PdxGuiFoldOut.IsUnfolded]"
			}
			blockoverride "left_text" {
				text = je_gate_expedition_dungeon_layer_all
			}
		}

		gate_dungeon_layers = {
			blockoverride "datamodel" {
				datamodel = "[DataModelFirst(ScriptContainer.MakeScope.Var('dungeon').GetList('layers'), '(int32)1')]"
			}
			blockoverride "top_line" {
				visible = no
			}
			blockoverride "layer_content" {
				gate_dungeon_layer_status = {}
			}
			visible = "[PdxGuiFoldOut.IsUnfolded]"
		}
		gate_dungeon_layers = {
			blockoverride "datamodel" {
				datamodel = "[DataModelSubSpan(
					ScriptContainer.MakeScope.Var('dungeon').GetList('layers'),
					'(int32)1',
					GetDataModelSize(ScriptContainer.MakeScope.Var('dungeon').GetList('layers'))
				)]"
			}
			blockoverride "layer_content" {
				gate_dungeon_layer_status = {}
			}
			visible = "[PdxGuiFoldOut.IsUnfolded]"
		}
	}

}