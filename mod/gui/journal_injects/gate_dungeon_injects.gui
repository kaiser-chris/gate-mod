@layer_width = 500
@layer_height = 52


flowcontainer = {
	name = "gate_inject_dungeon"
	parentanchor = hcenter
	direction = vertical
	spacing = 12
	visible = "[JournalEntry.MakeScope.Var('expedition').IsSet]"
	datacontext = "[JournalEntry.MakeScope.Var('expedition').GetScriptContainer]"

	gate_journal_dungeon_expedition = {
		parentanchor = hcenter
	}

	gate_dungeon_layer_progress_line = {
		parentanchor = hcenter
	}

	gate_journal_dungeon_layers = {}

	gate_journal_dungeon_logs = {}
}

types gate_inject_dungeon_types {

	type gate_journal_dungeon_expedition = widget {
		block "dungeon_expedition_widget_size" {
			size = { 500 300 }
		}

		background = {
			visible = "[GetIdeology(ScriptContainer.MakeScope.Var('dungeon').Var('type').GetFlagName).GetTexture]"
			texture = gfx/map/gate/dungeon/types/cave_01.dds
			fittype = centercrop
			alpha = 0.5
		}

		flowcontainer = {
			parentanchor = right|vcenter
			direction = vertical
			spacing = 5

			com_journal_entry_frame_text = {
				visible = "[ScriptContainer.MakeScope.Var('current_layer').IsSet]"
				blockoverride "text_top" {
					margin_right = 5
					text = je_gate_expedition_dungeon_layer_active
				}
				blockoverride "text" {
					margin_right = 5
					raw_text = "#yellow [ScriptContainer.MakeScope.Var('current_layer').Var('name').GetFlagName]#!"
				}
				blockoverride "icon" {
					visible = no
				}
				tooltipwidget = {
					gate_dungeon_layer_tooltip = {
						datacontext = "[ScriptContainer.MakeScope.Var('current_layer')]"
					}
				}
			}

			com_journal_entry_frame_text = {
				blockoverride "text_top" {
					margin_right = 5
					raw_text = "[Concept('concept_gate_dungeon_party_cohesion', Localize('concept_gate_dungeon_party_cohesion_medium'))]"
				}
				blockoverride "text" {
					margin_right = 5
					raw_text = "[ScriptContainer.MakeScope.ScriptValue('gate_dungeon_party_cohesion_value')|1v] / [ScriptContainer.MakeScope.ScriptValue('gate_dungeon_party_cohesion_max_value')|1]"
				}
				blockoverride "icon" {
					visible = no
				}
				tooltip = je_gate_expedition_dungeon_cohesion_tooltip
			}

			com_journal_entry_frame_text = {
				blockoverride "text_top" {
					margin_right = 5
					raw_text = "[Concept('concept_gate_dungeon_party_condition', Localize('concept_gate_dungeon_party_condition_medium'))]"
				}
				blockoverride "text" {
					margin_right = 5
					raw_text = "[ScriptContainer.MakeScope.ScriptValue('gate_dungeon_party_condition_value')|1v] / [ScriptContainer.MakeScope.ScriptValue('gate_dungeon_party_condition_max_value')|1]"
				}
				blockoverride "icon" {
					visible = no
				}
				tooltip = je_gate_expedition_dungeon_condition_tooltip
			}

			com_journal_entry_frame_text = {
				blockoverride "text_top" {
					margin_right = 5
					raw_text = "[Concept('concept_gate_dungeon_party_renown', Localize('concept_gate_dungeon_party_renown_medium'))]"
				}
				blockoverride "text" {
					margin_right = 5
					raw_text = "[ScriptContainer.MakeScope.ScriptValue('gate_dungeon_party_renown_value')|1v]"
				}
				blockoverride "icon" {
					visible = no
				}
				tooltip = je_gate_expedition_dungeon_renown_tooltip
			}
		}

		character_portrait_base_no_mask = {
			parentanchor = left|bottom
			ignore_in_debug_draw = yes
			size = { 300 300 }

			datacontext = "[ScriptContainer.MakeScope.Var('party').Var('party_leader').GetCharacter]"
			visible = "[ScriptContainer.MakeScope.Var('party').Var('party_leader').IsSet]"

			block "character_layout" {
				position = { -30 2 }
			}
			blockoverride "portrait_size" {
				block "character_portrait_size" {
					size = { 300 300 }
				}
			}
			blockoverride "portrait_texture" {
				portrait_texture = "[Character.GetAnimatedPortrait(
					'ruler_environment',
					'camera_body',
					'idle',
					GetPortraitRenderSize(PdxGuiWidget.Self))
				]"
			}
			blockoverride "portrait_icons" {}
			blockoverride "tooltip" {
				tooltipwidget = {
					FancyTooltip_Character = {}
				}
			}
		}

		icon = {
			position = { -30 2 }
			parentanchor = left|bottom
			size = { 300 300 }
			visible = "[Not(ScriptContainer.MakeScope.Var('party').Var('party_leader').IsSet)]"
			texture = gfx/portraits/example_portraits/unknown.dds
		}


		gate_titled_character = {
			parentanchor = left|bottom
			position = { 0 -20 }
			visible = "[Not(ScriptContainer.MakeScope.Var('party').Var('party_leader').IsSet)]"
			blockoverride "text_top" {
				text = je_gate_expedition_dungeon_party_leader
			}
			blockoverride "text" {
				raw_text = je_gate_expedition_dungeon_party_leader_empty
			}
			blockoverride "icon" {
				visible = no
			}
		}

		gate_titled_character = {
			parentanchor = left|bottom
			position = { 0 -20 }
			visible = "[ScriptContainer.MakeScope.Var('party').Var('party_leader').IsSet]"
			blockoverride "text_top" {
				text = je_gate_expedition_dungeon_party_leader
			}
			blockoverride "text" {
				raw_text = "[ScriptContainer.MakeScope.Var('party').Var('party_leader').GetCharacter.GetFullName]"
			}
			blockoverride "icon" {
				visible = no
			}
		}

		# FRAME
		widget = {
			size = { 100% 100% }
			background = {
				texture = "gfx/interface/character_panel/char_bg_frame.dds"
				margin_left = 18
				margin_right = 12
				margin_bottom = 10
				spriteType = Corneredtiled

				spriteborder_left = 200
				spriteborder_right = 60
				spriteborder_top = 170
				spriteborder_bottom = 180

				texture_density = 2
			}
		}
	}

	type gate_titled_character = widget {
		background = {
			using = dark_area
			alpha = 0.75

			modify_texture = {
				texture = "gfx/interface/masks/fade_horizontal_center.dds"
				blend_mode = alphamultiply
			}
		}

		size = { 250 53 }

		divider_clean = {
			parentanchor = top
		}
		divider_clean = {
			parentanchor = bottom
		}

		hbox = {
			margin_right = 13
			margin_left = 10
			layoutpolicy_horizontal = expanding
			layoutpolicy_vertical = expanding
			spacing = 7

			vbox = {
				layoutpolicy_horizontal = expanding
				layoutpolicy_vertical = expanding
				margin = { 0 7 }
				spacing = 3

				textbox = {
					layoutpolicy_horizontal = expanding
					size = { 0 16 }
					block "text_top" {
						raw_text = "#r frame_text text_top#!"
					}
					align = center
					elide = right
					fontsize_min = 12
				}

				textbox = {
					layoutpolicy_horizontal = expanding
					size = { 0 20 }
					block "text" {
						raw_text = "#r frame_text text#!"
					}
					align = center
					elide = right
					fontsize_min = 12
					using = fontsize_large
				}
			}

			icon = {
				size = { 35 35 }
				block "icon" {
					texture = gfx/interface/icons/alert_icons/placeholder.dds
				}
			}
		}
	}

	type gate_journal_dungeon_layers = flowcontainer {
		visible = "[DataModelHasItems(ScriptContainer.MakeScope.Var('dungeon').GetList('layers'))]"
		parentanchor = hcenter
		direction = vertical
		oncreate = "[BindFoldOutContext]"

		section_header_button = {
			parentanchor = hcenter
			onclick = "[PdxGuiFoldOut.Toggle]"

			blockoverride "layout" {
				size = { @[layer_width + 30] 38 }
			}
			blockoverride "onclick_showmore" {
				visible = "[Not(PdxGuiFoldOut.IsUnfolded)]"
			}
			blockoverride "onclick_showless" {
				visible = "[PdxGuiFoldOut.IsUnfolded]"
			}
			blockoverride "left_text" {
				text = je_gate_expedition_dungeon_layer_all
			}
		}

		gate_dungeon_layers = {
			blockoverride "datamodel" {
				datamodel = "[DataModelFirst(ScriptContainer.MakeScope.Var('dungeon').GetList('layers'), '(int32)1')]"
			}
			blockoverride "top_line" {
				visible = no
			}
			blockoverride "layer_content" {
				gate_dungeon_layer_status = {}
			}
			visible = "[PdxGuiFoldOut.IsUnfolded]"
		}
		gate_dungeon_layers = {
			blockoverride "datamodel" {
				datamodel = "[DataModelSubSpan(
					ScriptContainer.MakeScope.Var('dungeon').GetList('layers'),
					'(int32)1',
					GetDataModelSize(ScriptContainer.MakeScope.Var('dungeon').GetList('layers'))
				)]"
			}
			blockoverride "layer_content" {
				gate_dungeon_layer_status = {}
			}
			visible = "[PdxGuiFoldOut.IsUnfolded]"
		}
	}

	type gate_journal_dungeon_logs = flowcontainer {
		parentanchor = hcenter
		direction = vertical
		oncreate = "[BindFoldOutContext]"

		@log_entry_width = 500
		@log_entry_height = 60
		@log_entry_icon_width = 60
		@log_entry_date_width = 120
		@log_entry_info_width = @[log_entry_width - log_entry_icon_width - log_entry_date_width]

		section_header_button = {
			parentanchor = hcenter
			onclick = "[PdxGuiFoldOut.Toggle]"

			blockoverride "layout" {
				size = { @[layer_width + 30] 38 }
			}
			blockoverride "onclick_showmore" {
				visible = "[Not(PdxGuiFoldOut.IsUnfolded)]"
			}
			blockoverride "onclick_showless" {
				visible = "[PdxGuiFoldOut.IsUnfolded]"
			}
			blockoverride "left_text" {
				text = je_gate_expedition_dungeon_log_entries_all
			}
		}

		flowcontainer = {
			using = default_list_position
			direction = vertical
			margin_top = 5
			margin_bottom = 10

			# Header
			widget = {
				parentanchor = hcenter
				size = { @log_entry_width 30 }
				visible = "[PdxGuiFoldOut.IsUnfolded]"
				hbox = {
					spacing = 2
					layoutpolicy_horizontal = expanding
					button = {
						using = sort_button_bg
						enabled = no
						text = je_gate_expedition_dungeon_log_entries_header_type
						minimumsize = { @log_entry_icon_width 30 }
						maximumsize = { @log_entry_icon_width 30 }
						align = hcenter|nobaseline
						margin_left = 10
						margin_right = 10
						elide = right
					}
					button = {
						using = sort_button_bg
						layoutpolicy_horizontal = expanding
						enabled = no
						text = je_gate_expedition_dungeon_log_entries_header_event
						minimumsize = { -1 30 }
						maximumsize = { -1 30 }
						align = hcenter|nobaseline
						margin_left = 10
						margin_right = 10
						elide = right
					}
					button = {
						using = sort_button_bg
						enabled = no
						text = je_gate_expedition_dungeon_log_entries_header_date
						minimumsize = { @log_entry_date_width 30 }
						maximumsize = { @log_entry_date_width 30 }
						align = hcenter|nobaseline
						margin_left = 10
						margin_right = 10
						elide = right
					}
				}
			}

			# Over 10 items
			flowcontainer = {
				using = default_list_position
				visible = "[And3(
					PdxGuiFoldOut.IsUnfolded,
					DataModelHasItems(ScriptContainer.MakeScope.GetList('log_entries')),
					GreaterThan_int32(GetDataModelSize(ScriptContainer.MakeScope.GetList('log_entries')), '(int32)10')
				)]"
				margin_top = 5
				direction = vertical
				datamodel = "[DataModelLast(ScriptContainer.MakeScope.GetList('log_entries'), '(int32)10')]"
				spacing = 5
				bottomtotop = yes

				item = {
					gate_journal_dungeon_log_entry = {}
				}
			}
			textbox = {
				visible = "[And3(
					PdxGuiFoldOut.IsUnfolded,
					DataModelHasItems(ScriptContainer.MakeScope.GetList('log_entries')),
					GreaterThan_int32(GetDataModelSize(ScriptContainer.MakeScope.GetList('log_entries')), '(int32)10')
				)]"
				margin_top = 10
				size = { @log_entry_width 20 }
				text = je_gate_expedition_dungeon_log_entries_limit
				align = center
			}

			# Under 10 items
			flowcontainer = {
				using = default_list_position
				visible = "[And3(
					PdxGuiFoldOut.IsUnfolded,
					DataModelHasItems(ScriptContainer.MakeScope.GetList('log_entries')),
					Not(GreaterThan_int32(GetDataModelSize(ScriptContainer.MakeScope.GetList('log_entries')), '(int32)10'))
				)]"
				margin_top = 5
				direction = vertical
				datamodel = "[ScriptContainer.MakeScope.GetList('log_entries')]"
				spacing = 5
				bottomtotop = yes

				item = {
					gate_journal_dungeon_log_entry = {}
				}
			}

			flowcontainer = {
				using = default_list_position
				visible = "[And(
					PdxGuiFoldOut.IsUnfolded,
					Not(DataModelHasItems(ScriptContainer.MakeScope.GetList('log_entries')))
				)]"
				direction = vertical

				textbox = {
					size = { @log_entry_width 80 }
					text = je_gate_expedition_dungeon_log_entries_empty
					align = center
				}
			}
		}
	}

	type gate_journal_dungeon_log_entry = widget {
		size = { @log_entry_width @log_entry_height }

		background = {
			using = dark_area
			margin_left = -25
			alpha = 0.1
			modify_texture = {
				using = simple_frame_mask
			}
		}
		background = {
			using = simple_frame
			margin_left = -25
		}

		flowcontainer = {
			textbox = {
				size = { @log_entry_icon_width @log_entry_height }
				align = center
				raw_text = "[Scope.Var('rating').GetFlagName]"
				using = fontsize_xxl
				background = {
					margin = { 3 3 }
					texture = "gfx/interface/backgrounds/round_button_bg.dds"
				}
			}
			widget = {
				size = { @log_entry_info_width @log_entry_height }
				# Event Name
				textbox = {
					size = { @[log_entry_info_width - 10] @[log_entry_height / 2] }
					margin_bottom = 4
					parentanchor = right|top
					raw_text = "[Scope.Var('event').GetFlagName]"
					default_format = "#header"
					align = center
					background = {
						using = default_header_bg_faded
						margin_top = 2
					}
				}
				# Result: text only
				textbox = {
					visible = "[Not(Scope.Var('outcome_value').IsSet)]"
					size = { @[log_entry_info_width - 10] @[log_entry_height / 2] }
					position = { 0 -2 }
					parentanchor = right|bottom
					raw_text = "[Scope.Var('outcome_text').GetFlagName]"
					align = center
				}
				# Result: text + value
				widget = {
					visible = "[Scope.Var('outcome_value').IsSet]"
					size = { @[log_entry_info_width - 10] @[log_entry_height / 2] }
					position = { 0 -2 }
					parentanchor = right|bottom
					flowcontainer = {
						parentanchor = center
						spacing = 5
						textbox = {
							autoresize = yes
							raw_text = "[Scope.Var('outcome_text').GetFlagName]"
						}
						textbox = {
							autoresize = yes
							raw_text = "[Scope.Var('outcome_value').GetValue|1+]"
						}
					}
				}
			}
			widget = {
				size = { @log_entry_date_width @log_entry_height }
				textbox = {
					autoresize = yes
					parentanchor = center
					raw_text = "#v [TimeKeeper.GetCurrentDateWithDiff(FixedPointToInt(Scope.ScriptValue('gate_dungeon_creation_time')))]#!"
					background = {
						using = entry_bg
						margin = { 10 5 }
					}
				}
			}
		}
	}

}