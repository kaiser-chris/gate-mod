# INHERITED FROM BASE GAME
@layer_width = 500
@layer_height = 52

#### WIDGETS
flowcontainer = {
	name = "gate_inject_dungeon_layers"
	parentanchor = hcenter
	direction = vertical
	spacing = 12
	visible = "[JournalEntry.MakeScope.Var('expedition').IsSet]"

	gate_journal_dungeon_expedition = {
		datacontext = "[JournalEntry.MakeScope.Var('expedition').GetScriptContainer]"
	}

	flowcontainer = {
		visible = "[DataModelHasItems(ScriptContainer.MakeScope.Var('dungeon').GetList('layers'))]"
		datacontext = "[JournalEntry.MakeScope.Var('expedition').GetScriptContainer]"
		parentanchor = hcenter
		direction = vertical
		oncreate = "[BindFoldOutContext]"

		section_header_button = {
			parentanchor = hcenter
			onclick = "[PdxGuiFoldOut.Toggle]"

			blockoverride "layout" {
				size = { 500 38 }
			}
			blockoverride "onclick_showmore" {
				visible = "[Not(PdxGuiFoldOut.IsUnfolded)]"
			}
			blockoverride "onclick_showless" {
				visible = "[PdxGuiFoldOut.IsUnfolded]"
			}
			blockoverride "left_text" {
				text = je_gate_expedition_dungeon_step_all
			}
		}

		gate_dungeon_layers = {
			blockoverride "datamodel" {
				datamodel = "[DataModelFirst(ScriptContainer.MakeScope.Var('dungeon').GetList('layers'), '(int32)1')]"
			}
			blockoverride "top_line" {
				visible = no
			}
			visible = "[PdxGuiFoldOut.IsUnfolded]"
		}
		gate_dungeon_layers = {
			blockoverride "datamodel" {
				datamodel = "[DataModelSubSpan(
				ScriptContainer.MakeScope.Var('dungeon').GetList('layers'),
				'(int32)1',
				GetDataModelSize(ScriptContainer.MakeScope.Var('dungeon').GetList('layers'))
			)]"
			}
			visible = "[PdxGuiFoldOut.IsUnfolded]"
		}
	}

}

types gate_inject_dungeon_layer_types {

	type gate_journal_dungeon_expedition = widget {
		parentanchor = hcenter
		size = { 500 300 }
		using = gate_dungeon_background

		flowcontainer = {
			parentanchor = right|vcenter
			direction = vertical
			spacing = 5

			com_journal_entry_frame_text = {
				blockoverride "text_top" {
					raw_text = "[concept_gate_expedition_leader]"
				}
				blockoverride "text" {
					text = "[GetPlayer.GetRuler.GetFullName]"
				}
				blockoverride "icon" {
					texture = "gfx/interface/icons/character_role_icons/executive.dds"
				}
			}

			com_journal_entry_frame_text = {
				blockoverride "text_top" {
					raw_text = "[concept_gate_dungeon]"
				}
				blockoverride "text" {
					text = "[ScriptContainer.MakeScope.Var('dungeon').Var('name').GetFlagName]"
				}
				blockoverride "icon" {
					texture = "gfx/interface/icons/notification_icons/buildings.dds"
				}
			}

			com_journal_entry_frame_text = {
				blockoverride "text_top" {
					text = je_gate_expedition_dungeon_step_active
				}
				blockoverride "text" {
					text = "[ScriptContainer.MakeScope.Var('current_step').Var('name').GetFlagName]"
				}
				blockoverride "icon" {
					texture = "gfx/interface/icons/alert_icons/formable_possible.dds"
				}
			}
		}

		character_portrait_base_no_mask = {
			parentanchor = left|bottom
			ignore_in_debug_draw = yes
			size = { 300 300 }

			datacontext = "[GetPlayer.GetRuler]"

			block "character_layout" {
				position = { -30 2 }
			}
			blockoverride "portrait_size" {
				block "character_portrait_size" {
					size = { 300 300 }
				}
			}
			blockoverride "portrait_texture" {
				portrait_texture = "[Character.GetAnimatedPortrait(
							'ruler_environment',
							'camera_body',
							'idle',
							GetPortraitRenderSize(PdxGuiWidget.Self))
						]"
			}
			blockoverride "portrait_icons" {}
			blockoverride "tooltip" {
				tooltipwidget = {
					FancyTooltip_Character = {}
				}
			}
		}

		# FRAME
		widget = {
			size = { 100% 100% }
			background = {
				texture = "gfx/interface/character_panel/char_bg_frame.dds"
				margin_left = 18
				margin_right = 12
				margin_bottom = 10
				spriteType = Corneredtiled

				spriteborder_left = 200
				spriteborder_right = 60
				spriteborder_top = 170
				spriteborder_bottom = 180

				texture_density = 2
			}
		}
	}

	type gate_dungeon_layers = flowcontainer {
		using = default_list_position
		direction = vertical
		block "datamodel" {
			datamodel = "[ScriptContainer.MakeScope.Var('dungeon').GetList('layers')]"
		}

		item = {
			widget = {
				size = { @layer_width @layer_height }
				using = gate_dungeon_layer_images
			}
		}
	}

	type gate_dungeon_layer_image = icon {
		size = { @layer_width @layer_height }
		parentanchor = center

		block "texture" {}

		block "layer_mask" {
			modify_texture = {
				texture = "gfx/interface/masks/fade_horizontal_center.dds"
				spriteType = Corneredtiled
				spriteborder = { 200 200 }
				texture_density = 4
				blend_mode = alphamultiply
			}
		}

		container = {
			parentanchor = vcenter|left
			minimumsize = { -1 @layer_height }
			maximumsize = { -1 @layer_height }
			visible = "[Or(
				GetScriptedGui('sgui_gate_dungeon_layer_complete').IsShown(GuiScope.SetRoot(ScriptContainer.MakeScope).AddScope('layer', Scope.GetScriptContainer.MakeScope).End),
				ObjectsEqual(ScriptContainer.MakeScope.Var('current_step').Var('name').GetFlagName, Scope.Var('name').GetFlagName)
			)]"

			background = {
				using = dark_area
				alpha = 0.75

				modify_texture = {
					texture = "gfx/interface/masks/fade_horizontal_center.dds"
					blend_mode = alphamultiply
				}
			}

			textbox = {
				minimumsize = { -1 @layer_height }
				maximumsize = { -1 @layer_height }
				margin_left = 60
				margin_right = 20
				autoresize = yes
				text = "[Scope.Var('name').GetFlagName]"
				align = vcenter|left
			}
		}

		### Darken uncompleted layers
		icon = {
			visible = "[And(
				Not(GetScriptedGui('sgui_gate_dungeon_layer_complete').IsShown(GuiScope.SetRoot(ScriptContainer.MakeScope).AddScope('layer', Scope.GetScriptContainer.MakeScope).End)),
				Not(ObjectsEqual(ScriptContainer.MakeScope.Var('current_step').Var('name').GetFlagName, Scope.Var('name').GetFlagName))
			)]"
			size = { @layer_width @layer_height }
			parentanchor = center
			texture = "gfx/frontend/interface/colors/black.dds"
			alpha = 0.7

			modify_texture = {
				texture = "gfx/interface/masks/fade_horizontal_center.dds"
				spriteType = Corneredtiled
				spriteborder = { 200 200 }
				texture_density = 4
				blend_mode = alphamultiply
			}
		}

		### Progress between layers
		gate_dungeon_layer_image_progress = {
			block "top_line" {
				visible = "[And(
					GetScriptedGui('sgui_gate_dungeon_layer_complete').IsShown(GuiScope.SetRoot(ScriptContainer.MakeScope).AddScope('layer', Scope.GetScriptContainer.MakeScope).End),
					Not(ObjectsEqual(ScriptContainer.MakeScope.Var('current_step').Var('name').GetFlagName, Scope.Var('name').GetFlagName))
				)]"
			}
			blockoverride "line_texture" {
				texture = "gfx/interface/progressbar/progressbar_green.dds"
			}
			parentanchor = top|left
			size = { 8 24 }
			position = { 31 -12 }
		}
		gate_dungeon_layer_image_progress = {
			block "top_line" {
				visible = "[And(
					Not(GetScriptedGui('sgui_gate_dungeon_layer_complete').IsShown(GuiScope.SetRoot(ScriptContainer.MakeScope).AddScope('layer', Scope.GetScriptContainer.MakeScope).End)),
					Not(ObjectsEqual(ScriptContainer.MakeScope.Var('current_step').Var('name').GetFlagName, Scope.Var('name').GetFlagName))
				)]"
			}
			blockoverride "line_texture" {
				texture = "gfx/interface/progressbar/progressbar_empty.dds"
			}
			parentanchor = top|left
			size = { 8 24 }
			position = { 31 -12 }
		}
		gate_dungeon_layer_image_progress = {
			block "top_line" {
				visible = "[ObjectsEqual(ScriptContainer.MakeScope.Var('current_step').Var('name').GetFlagName, Scope.Var('name').GetFlagName)]"
			}
			blockoverride "line_texture" {
				texture = "gfx/interface/progressbar/progressbar_default.dds"
			}
			blockoverride "line_in_progress" {
				visible = yes
			}
			parentanchor = top|left
			size = { 8 24 }
			position = { 31 -12 }
		}

		### Layer state icon
		icon = {
			parentanchor = vcenter|left
			position = { 20 0 }
			size = { 30 30 }
			texture = "gfx/interface/buttons/round_button_big_bg.dds"

			modify_texture = {
				visible = "[ObjectsEqual(ScriptContainer.MakeScope.Var('current_step').Var('name').GetFlagName, Scope.Var('name').GetFlagName)]"
				name = "selected"
				texture = "gfx/interface/buttons/round_button_selected.dds"
				spriteType = Corneredstretched
				spriteborder = { 0 0 }
				blend_mode = overlay
			}

			icon = {
				visible = "[GetScriptedGui('sgui_gate_dungeon_layer_complete').IsShown(GuiScope.SetRoot(ScriptContainer.MakeScope).AddScope('layer', Scope.GetScriptContainer.MakeScope).End)]"
				parentanchor = center
				size = { 25 25 }
				texture = "gfx/interface/buttons/button_icons/unlock.dds"
			}

			icon = {
				visible = "[Not(GetScriptedGui('sgui_gate_dungeon_layer_complete').IsShown(GuiScope.SetRoot(ScriptContainer.MakeScope).AddScope('layer', Scope.GetScriptContainer.MakeScope).End))]"
				parentanchor = center
				size = { 25 25 }
				texture = "gfx/interface/buttons/button_icons/lock.dds"
			}
		}

		### Layer Tooltip
		tooltipwidget = {
			RegularTooltip = {
				blockoverride "tooltip_content" {
					custom_tooltip_textbox = {
						text = "[Scope.Var('name').GetFlagName]"
						default_format = "#header"
					}
					custom_tooltip_textbox_with_empty_line = {
						text = "[Scope.Var('desc').GetFlagName]"
					}
					custom_tooltip_textbox = {
						visible = "[And(
							GetScriptedGui('sgui_gate_dungeon_layer_complete').IsShown(GuiScope.SetRoot(ScriptContainer.MakeScope).AddScope('layer', Scope.GetScriptContainer.MakeScope).End),
							Not(ObjectsEqual(ScriptContainer.MakeScope.Var('current_step').Var('name').GetFlagName, Scope.Var('name').GetFlagName))
						)]"
						text = gate_dungeon_layer_done
					}
					custom_tooltip_textbox = {
						visible = "[And(
							Not(GetScriptedGui('sgui_gate_dungeon_layer_complete').IsShown(GuiScope.SetRoot(ScriptContainer.MakeScope).AddScope('layer', Scope.GetScriptContainer.MakeScope).End)),
							Not(ObjectsEqual(ScriptContainer.MakeScope.Var('current_step').Var('name').GetFlagName, Scope.Var('name').GetFlagName))
						)]"
						text = gate_dungeon_layer_open
					}
					custom_tooltip_textbox = {
						visible = "[ObjectsEqual(ScriptContainer.MakeScope.Var('current_step').Var('name').GetFlagName, Scope.Var('name').GetFlagName)]"
						text = gate_dungeon_layer_in_progress
					}
				}
			}
		}
	}

	type gate_dungeon_layer_image_progress = icon {
		block "line_texture" {
			texture = "gfx/interface/progressbar/progressbar_default.dds"
		}
		framesize = { 32 8 }
		frame = 2

		icon = {
			block "line_in_progress" {
				visible = no
			}
			size = { 100% 100% }
			block "line_texture" {
				texture = "gfx/interface/progressbar/progressbar_default.dds"
			}
			shaderfile = "gfx/FX/pdxgui_repeat_texture.shader"

			modify_texture = {
				texture = "gfx/interface/backgrounds/light_bg.dds"
				spriteType = CorneredTiled
				spriteborder = { 6 6 }
				texture_density = 2
				blend_mode = overlay
			}

			modify_texture = {
				name = arrow_animation
				texture = "gfx/interface/progressbar/gate_progressbar_arrow_horizontal.dds"
				spriteType = Corneredtiled
				spriteborder = { 0 0 }
				block "arrow_texture_density" {
					texture_density = 20 #use to match height of progressbar
				}
				translate_uv = { 0 0 }
				blend_mode = alphamultiply
				mirror = horizontal
			}

			state = {
				trigger_on_create = yes
				name = arrow_animation_1
				next = arrow_animation_2
				duration = 1

				modify_texture = {
					name = arrow_animation
					translate_uv = { 0 -1 }
				}
			}
			state = {
				name = arrow_animation_2
				next = arrow_animation_1
				duration = 0

				modify_texture = {
					name = arrow_animation
					translate_uv = { 0 0 }
				}
			}
		}
	}

}

template "gate_dungeon_background" {
	background = {
		visible = "[EqualTo_CFixedPoint(ScriptContainer.MakeScope.Var('dungeon').Var('type').GetValue, ScriptContainer.MakeScope.ScriptValue('gate_dungeon_cave_01'))]"
		texture = gfx/map/gate/dungeon/types/cave_01.dds
		fittype = centercrop
		alpha = 0.5
	}
}

template "gate_dungeon_layer_images" {
	gate_dungeon_layer_image = {
		visible = "[EqualTo_CFixedPoint(Scope.Var('type').GetValue, Scope.ScriptValue('gate_dungeon_layer_top_cave_01'))]"
		blockoverride "texture" {
			texture = gfx/map/gate/dungeon/layers/top_cave_01.dds
		}
	}
	gate_dungeon_layer_image = {
		visible = "[EqualTo_CFixedPoint(Scope.Var('type').GetValue, Scope.ScriptValue('gate_dungeon_layer_inner_classic_01'))]"
		blockoverride "texture" {
			texture = gfx/map/gate/dungeon/layers/inner_classic_01.dds
		}
	}
	gate_dungeon_layer_image = {
		visible = "[EqualTo_CFixedPoint(Scope.Var('type').GetValue, Scope.ScriptValue('gate_dungeon_layer_inner_classic_02'))]"
		blockoverride "texture" {
			texture = gfx/map/gate/dungeon/layers/inner_classic_02.dds
		}
	}
	gate_dungeon_layer_image = {
		visible = "[EqualTo_CFixedPoint(Scope.Var('type').GetValue, Scope.ScriptValue('gate_dungeon_layer_inner_classic_03'))]"
		blockoverride "texture" {
			texture = gfx/map/gate/dungeon/layers/inner_classic_03.dds
		}
	}
	gate_dungeon_layer_image = {
		visible = "[EqualTo_CFixedPoint(Scope.Var('type').GetValue, Scope.ScriptValue('gate_dungeon_layer_inner_classic_04'))]"
		blockoverride "texture" {
			texture = gfx/map/gate/dungeon/layers/inner_classic_04.dds
		}
	}
}